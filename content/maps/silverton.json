"signs": [
{
"x": 5,
"y": 5,
"text": "NORTH GATE. The Doors road, up the mountain. The locals call it the Coldridge route.",
"src": "wiki/the-road.md (the Doors road); rumors r-coldridge (wiki/fountain-street.md HD-1)"
},
{
"x": 29,
"y": 5,
"text": "The vault door. The highway to Deepholm. Nobody bothers the dwarves. Not since the Water Burning.",
"src": "wiki/silverton.md (the one law: nobody bothers the dwarves)",
"cond": "!flag:frontDoor"
},
{
"x": 30,
"y": 5,
"text": "The vault door. The highway to Deepholm. Nobody bothers the dwarves. Not since the Water Burning.",
"src": "wiki/silverton.md (the one law: nobody bothers the dwarves)",
"cond": "!flag:frontDoor"
},
{
"x": 24,
"y": 40,
"text": "Sylvia Swann's booth: an owl painted on the board. The short reading, five silver. She isn't in.",
"src": "wiki/silverton.md; the-lab/pit-maps/shops-silverton.json pin 37"
},
{
"x": 31,
"y": 40,
"text": "The Vizardry mask-booth. Crude vizards with a hedge-glamour, a gold the hour. The real house is somewhere else.",
"src": "wiki/vice-row.md; the-lab/pit-maps/shops-silverton.json pin 39"
},
{
"x": 40,
"y": 41,
"text": "The card cellars. Low table buy-in five silver. The stairs go down; you do not.",
"src": "the-lab/pit-maps/shops-silverton.json pin 41"
},
{
"x": 45,
"y": 32,
"text": "The arena family's house. The door is shut.",
"src": "wiki/silverton.md (pin 24, the arena family's house); reserved"
},
{
"x": 20,
"y": 41,
"text": "The row's cut. The landlord's door.",
"src": "wiki/silverton.md (vice row; Vondercamp reserved)"
},
{
"x": 22,
"y": 36,
"text": "Betting stalls. Book made openly on fights, quietly on everything else.",
"src": "the-lab/pit-maps/shops-silverton.json pin 18"
},
{
"x": 50,
"y": 32,
"text": "Warehouses. No quay: the river is too small and fast to carry anything.",
"src": "wiki/silverton.md; wiki/fountain-street.md (Mical)"
}
],
